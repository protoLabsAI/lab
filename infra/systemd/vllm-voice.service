[Unit]
Description=vLLM - Qwen3.6-35B-A3B no-thinking voice/agentic (GPU 1, port 8002, 256K)
After=network.target

[Service]
Type=simple
User=ava
ExecStart=/home/ava/dev/vllm-env/bin/vllm serve Qwen/Qwen3.6-35B-A3B-FP8 \
    -O3 \
    --host 0.0.0.0 --port 8002 \
    --served-model-name local-voice \
    --max-model-len 262144 \
    --chat-template /home/ava/dev/lab/models/templates/qwen3_nonthinking.jinja \
    --enable-auto-tool-choice --tool-call-parser qwen3_xml \
    --gpu-memory-utilization 0.73 \
    --language-model-only \
    --attention-backend TRITON_ATTN \
    --enable-chunked-prefill \
    --enable-prefix-caching \
    --kv-cache-dtype fp8 \
    --async-scheduling \
    --performance-mode interactivity
Restart=on-failure
RestartSec=30
Environment=PATH=/home/ava/dev/vllm-env/bin:/usr/local/cuda-12.8/bin:/usr/local/bin:/usr/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64
Environment=HF_HOME=/mnt/models/huggingface
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=CUDA_VISIBLE_DEVICES=1
StandardOutput=append:/mnt/scratch/logs/vllm-voice.log
StandardError=append:/mnt/scratch/logs/vllm-voice.log

[Install]
WantedBy=multi-user.target
