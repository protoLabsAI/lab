[Unit]
Description=vLLM - Qwen3.6-27B-FP8 thinking/planning (GPU 0, port 8000, 256K)
After=network.target

[Service]
Type=simple
User=ava
ExecStart=/home/ava/dev/vllm-env/bin/vllm serve Qwen/Qwen3.6-27B-FP8 \
    -O3 \
    --host 0.0.0.0 --port 8000 \
    --served-model-name local \
    --max-model-len 262144 \
    --max-num-seqs 512 \
    --reasoning-parser qwen3 \
    --enable-auto-tool-choice --tool-call-parser qwen3_xml \
    --gpu-memory-utilization 0.90 \
    --enable-chunked-prefill \
    --enable-prefix-caching
Restart=on-failure
RestartSec=30
Environment=PATH=/home/ava/dev/vllm-env/bin:/usr/local/cuda-12.8/bin:/usr/local/bin:/usr/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64
Environment=HF_HOME=/mnt/models/huggingface
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=CUDA_VISIBLE_DEVICES=0
StandardOutput=append:/mnt/scratch/logs/vllm.log
StandardError=append:/mnt/scratch/logs/vllm.log

[Install]
WantedBy=multi-user.target
